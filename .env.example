# Copy to .env for local runs. Do NOT commit .env.
# In CI, these come from GitHub Actions secrets, not from a file.

# Asana Personal Access Token. Treat like a password.
ASANA_PAT=

# Google service account JSON. Paste the entire JSON on one line, or set
# GOOGLE_CREDENTIALS_FILE to a local path to the JSON file instead.
GOOGLE_CREDENTIALS=
GOOGLE_CREDENTIALS_FILE=

# n8n Webhook URL (the production URL from the Webhook node, NOT the test URL).
N8N_WEBHOOK_URL=

# Optional run-mode overrides (default values shown).
# DRY_RUN_ASANA=true        # never write to Asana when true
# WRITE_TEST_CONTRACT=       # set to a single contract task GID to limit writes to one
