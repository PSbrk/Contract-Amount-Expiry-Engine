# Copy to .env for local runs. Do NOT commit .env.
# In CI these come from GitHub Actions secrets, not from a file.

# Asana Personal Access Token. Treat like a password.
ASANA_PAT=

# Airtable Personal Access Token. Scope it to a single base. Required scopes:
#   data.records:read, data.records:write, schema.bases:read, schema.bases:write
AIRTABLE_PAT=

# Airtable base ID — the `app...` segment in the base URL.
AIRTABLE_BASE_ID=

# Optional run-mode overrides (defaults shown).
# DRY_RUN_ASANA=true        # never write to Asana when true; default true
#                            # for safety. Set to "false" to enable real writes.
# WRITE_TEST_CONTRACT=       # set to a single Asana task GID to limit
#                            # writes to that one contract (test rollout).

# OneDrive backup of data/engine.db. After every successful --ingest, the
# engine copies the SQLite database here so OneDrive's sync client can push
# it to the cloud — no Microsoft Graph API auth needed. Point at any
# OneDrive-synced folder. Unset = backup skipped. Failures log a warning
# but never fail the ingest run; the local DB remains the source of truth.
# ONEDRIVE_BACKUP_PATH=C:\Users\<you>\OneDrive\Backups\engine.db
